7,"rejected":57,"closed":0,"total":171},{"year":2022,"recognized":102,"complementary":31,"rejected":20,"closed":5,"total":158},{"year":2023,"recognized":44,"complementary":15,"rejected":22,"closed":43,"total":124},{"year":2024,"recognized":48,"complementary":11,"rejected":35,"closed":12,"total":106},{"year":2025,"recognized":29,"complementary":5,"rejected":5,"closed":5,"total":44}]},"per_1000":{"year":2025,"value":0.04,"numerator":2132,"denominator":58915656,"sources":["unhcr-pop-2026","wb-pop-2026"],"note":"Refugees per 1,000 people living in Italy."}},"headlines":{"over_time":{"text":"Eritrean refugees in Italy rose from {n0} (1980) to {n1} (2014), then fell to {n2} (2025)","nums":[142,13357,2132],"years":[1980,2014,2025]},"where_people_are":{"text":"Italy hosts {p0} of all Eritrean refugees (2025), down from {p1} in 1980","pcts":[0.4,26.2],"years":[2025,1980]}},"steps":{"brief":true,"key_numbers":true,"over_time":true,"where_people_are":true,"inside_outside":true,"compare":false,"context":true,"other_angles":true,"limitations":true,"sources":true},"brief_sources":[],"footnotes":{"fn_206a4022":"The number of refugees was rebased using updated data on the number of residence permit holder with refugee status and temporary protection holders by the end of 2023, available from Eurostat.","fn_23410b66":"Figure from the National Institute of Statistics (ISTAT).","fn_28abb9cc":"Figure from the National Institute of Statistics (ISTAT).","fn_3148cfe0":"Figure from the National Institute of Statistics (ISTAT).","fn_43302f0f":"This figure is a combination of data published by the National Institute of Statistics (550 as of 1 January 2020), as well as estimates from NGOs on the number of persons who are stateless or at risk of statelessness present in Italy. The estimate number of stateless persons in Italy used to be between 3,000 to 15,000, and was reviewed in 2021 following the publication of the report of the Association 21 luglio “Fantasmi Urbani” (https://www.21luglio.org/2018/wp-content/uploads/2021/02/fantasmi-urbani-edit.pdf).","fn_5371def1":"The total number of refugees by end-2025 is an estimation based on the data on recognized refugees by end-2024, adding the recognitions during 2025 and deducting the recognitions during 2015, to which the total number of temporary protection status holders by end-year was added.","fn_5a3a54a8":"This figure is a combination of data published by the National Institute of Statistics (552 as of 1 January 2021), as well as estimates from NGOs on the number of persons who are stateless or at risk of statelessness present in Italy (see the advocacy paper of the Working Group on Statelessness, https://tavoloapolidia.org/app/uploads/2021/09/Advocacy-Paper-Tavolo-Apolidia_2021_def.pdf).","fn_8b530b44":"The stateless statistics figure is a combination of data published by the National Institute of Statistics (630 as of 1 January 2025), as well as estimates from NGOs on the number of persons who are stateless or at risk of statelessness present in Italy.","fn_8fdf5351":"Figure from the National Institute of Statistics (ISTAT).","fn_a4f846ea":"The number of refugees was rebased using updated data on the number of residence permit holder with refugee status and temporary protection holders by the end of 2022, available from Eurostat.","fn_b19d988b":"Updated figure from the National Institute of Statistics (ISTAT).","fn_c1f62ebb":"This figure is a combination of data published by the National Institute of Statistics (675 as of 1 January 2023), as well as estimates from NGOs on the number of persons who are stateless or at risk of statelessness present in Italy.","fn_c3c3e66e":"In 2020, the refugee estimates were updated using the data provided by ISTAT for 2019, augmented with the decisions on asylum applications provided by the Ministry of Interior in 2020. The ISTAT statistics provide the total number of people with valid refugee residence permits, disaggregated for the 50 most common countries of origins. This resulted in a reduction in the start-year refugee population of 91,200 refugees.","fn_c82bb08a":"Figure from the National Institute of Statistics (ISTAT).","fn_fa679db3":"The stateless statistics figure is a combination of data published by the National Institute of Statistics (570 as of 1 January 2024), as well as estimates from NGOs on the number of persons who are stateless or at risk of statelessness present in Italy."},"raw_files":{"conflict.csv":{"label":"IDMC GIDD, conflict and violence (HDX csv)","header":["iso3","country_name","year","new_displacement","new_displacement_rounded","total_displacement","total_displacement_rounded"]},"demographics/2025.zip":{"label":"UNHCR API download (demographics/2025.zip)","header":["Year","Country of origin","Country of origin (ISO)","Country of asylum","Country of asylum (ISO)","Population Type","Female 0 - 4","Female 5 - 11","Female 12 - 17","Female 18 - 59","Female 60","Female other","Female total","Male 0 - 4","Male 5 - 11","Male 12 - 17","Male 18 - 59","Male 60","Male other","Male total","Total"]},"persons_of_concern.csv":{"label":"UNHCR Refugee Data Finder download (persons_of_concern.csv)","header":["Year","Country of Asylum","Country of Origin","Country of Asylum ISO","Country of Origin ISO","Refugees","Asylum-seekers","IDPs","Other people in need of international protection","Stateless persons","Host community","Others of concern"]}},"raw_rows":{"conflict.csv#L126":{"file_key":"conflict.csv","line":126,"row":["ERI","Eritrea","2011","0","","10000","10000"]},"conflict.csv#L16":{"file_key":"conflict.csv","line":16,"row":["ERI","Eritrea","2009","0","","10000","10000"]},"conflict.csv#L185":{"file_key":"conflict.csv","line":185,"row":["ERI","Eritrea","2012","0","","10000","10000"]},"conflict.csv#L244":{"file_key":"conflict.csv","line":244,"row":["ERI","Eritrea","2013","0","","10000","10000"]},"conflict.csv#L304":{"file_key":"conflict.csv","line":304,"row":["ERI","Eritrea","2014","0","","10000","10000"]},"conf
enominator":11941781,"sources":["unhcr-pop-2026","wb-pop-2026"],"note":"Asylum seekers per 1,000 people living in Belgium."}},"headlines":{"over_time":{"text":"Guinean asylum seekers in Belgium rose from {n0} (2004) to {n1} (2025)","nums":[15,2870],"years":[2004,2025]},"where_people_are":{"text":"Belgium hosts {p0} of all Guinean asylum seekers (2025), down from {p1} in 2005","pcts":[5.1,23.3],"years":[2025,2005]}},"steps":{"brief":true,"key_numbers":true,"over_time":true,"where_people_are":true,"inside_outside":true,"compare":false,"context":true,"other_angles":true,"limitations":true,"sources":true},"brief_sources":[],"footnotes":{"fn_15c933a7":"Stateless persons reported by UNHCR correspond to recognized stateless persons who have been granted a residence permit in Belgium and who are therefore registered in the national register. It should be noted that recognized stateless persons who have not been granted a residence permit are not taken into account in figures provided by the Belgian Government. UNHCR no longer reports on the number of persons registered by the Belgian Government in the national register under categories such as “undetermined nationality” and “nationality not yet determined” as the definitions of these categories are broad and may encompass other groups than stateless persons.","fn_1cb7bfa0":"The refugee figure relates to the end of 2016.","fn_25cf9917":"Stateless persons reported by UNHCR correspond to recognized stateless persons who have been granted a residence permit in Belgium and who are therefore registered in the national register. It should be noted that recognized stateless persons who have not been granted a residence permit are not taken into account in figures provided by the Belgian Government.","fn_2ce37b3c":"Refugee figure relates to the end of 2016.","fn_358f0de6":"Source: Eurostat","fn_37d26a7b":"Stateless persons reported by UNHCR correspond to recognized stateless persons who have been granted a residence permit in Belgium and who are therefore registered in the national register. It should be noted that recognized stateless persons who have not been granted a residence permit are not taken into account in figures provided by the Belgian Government.","fn_3e3898f4":"Refugee figure relates to the end of 2016.","fn_6178591d":"Data refers to number of cases or mix of persons and cases.","fn_6650e90b":"Stateless persons reported by UNHCR correspond to recognized stateless persons who have been granted a residence permit in Belgium and who are therefore registered in the national register. It should be noted that recognized stateless persons who have not been granted a residence permit are not taken into account in figures provided by the Belgian Government.","fn_74bea089":"The data is based on the registered population as of end-2020, as data for 2021 was not available at time of publication apart from the data on asylum-seekers, which was sourced from Eurostat, and resettlement which was sourced from the Federal Agency for the Reception of Asylum Seekers.","fn_8e2d7783":"The data is based on the registered population as of end-2020, as data for 2021 was not available at time of publication apart from the data on asylum-seekers, which was sourced from Eurostat, and resettlement which was sourced from the Federal Agency for the Reception of Asylum Seekers.","fn_a971a679":"Stateless persons reported by UNHCR correspond to recognized stateless persons who have been granted a residence permit in Belgium and who are therefore registered in the national register. It should be noted that recognized stateless persons who have not been granted a residence permit are not taken into account in figures provided by the Belgian Government.","fn_c333c408":"Data refers to number of cases or mix of persons and cases.","fn_de57f937":"Stateless persons reported by UNHCR correspond to recognized stateless persons who have been granted a residence permit in Belgium and who are therefore registered in the national register. It should be noted that recognized stateless persons who have not been granted a residence permit are not taken into account in figures provided by the Belgian Government.","fn_f1cab7bd":"Belgium includes a 'stateless' category in its National Registry, which records people who have been recognised as stateless and issued long-term residence permits in Belgium. There are also stateless people who are not counted in the National Registry data, for example, people awaiting determination of their statelessness, people recognised as stateless but not granted a residence permit, stateless people holding a short-term residence permit, and stateless people in the asylum procedure.","fn_f93a70b7":"Refugee figure related to the end of 2016."},"raw_files":{"demographics/2025.zip":{"label":"UNHCR API download (demographics/2025.zip)","header":["Year","Country of origin","Country of origin (ISO)","Country of asylum","Country of asylum (ISO)","Population Type","Female 0 - 4","Female 5 - 11","Female 12 - 17","Female 18 - 59","Female 60","Female other","Female total","Male 0 - 4","Male 5 - 11","Male 12 - 17","Male 18 - 59","Male 60","Male other","Male total","Total"]},"persons_of_concern.csv":{"label":"UNHCR Refugee Data Finder download (persons_of_concern.csv)","header":["Year","Country of Asylum","Country of Origin","Country of Asylum ISO","Country of Origin ISO","Refugees","Asylum-seekers","IDPs","Other people in need of international protection","Stateless persons","Host community","Others of concern"]}},"raw_rows":{"demographics/2025.zip#L931":{"file_key":"demographics/2025.zip","line":931,"row":["2025","Guinea","GIN","Belgium","BEL","ASY","174","86","50","939","16","0","1265","100","101","98","1289","17","0","1605","2870"]},"persons_of_concern.csv#L103229":{"file_key":"persons_of_concern.csv","line":103229,"row":["2020","Belgium","Guinea","BEL","GIN","3446","1390","0","0","0","0","0"]},"persons_of_concern.csv#L108718":{"file_key":"persons_of_concern.csv","lin
0.0,100.0],[2023,81493,81493,81493,100.0,100.0],[2024,177996,177996,177996,100.0,100.0],[2025,199461,199461,199461,100.0,100.0]],"sentences":{"sex":{"text":"UNHCR records the sex of all {n0} refugees: {n1} women and {n2} men.","nums":[199461,100000,99461]},"age":{"text":"Ages are known for everyone: {n0} children (under 18), {n1} adults (18–59) and {n2} older people (60 and over).","nums":[52497,130020,16944,0,199461,199461],"pcts":[100.0,0.0]}},"notes":[{"text":"Age and sex are recorded for everyone in this group."}]},"missing_items":[],"reading":[],"datasets":["unhcr-pop-2026","unhcr-solutions-2026","unhcr-demographics-2026","idmc-conflict-2026","idmc-disaster-2026","ucdp-acd-26.1","ucdp-ov-26.1","wb-pop-2026"],"other_angles":{"asylum_applications":{"note":"New claims at first instance, all authorities (government, UNHCR, joint).","source_id":"unhcr-asylum-applications-2026","series":[{"year":2013,"value":11},{"year":2014,"value":34},{"year":2015,"value":37},{"year":2016,"value":10},{"year":2017,"value":11},{"year":2018,"value":12},{"year":2019,"value":18},{"year":2022,"value":4396},{"year":2023,"value":59},{"year":2024,"value":45},{"year":2025,"value":36}]},"asylum_decisions":{"note":"First-instance decisions, all authorities.","source_id":"unhcr-asylum-decisions-2026","series":[{"year":2013,"recognized":0,"complementary":0,"rejected":10,"closed":0,"total":10},{"year":2014,"recognized":0,"complementary":16,"rejected":5,"closed":10,"total":31},{"year":2015,"recognized":18,"complementary":5,"rejected":17,"closed":5,"total":45},{"year":2016,"recognized":5,"complementary":0,"rejected":0,"closed":5,"total":10},{"year":2017,"recognized":0,"complementary":0,"rejected":10,"closed":0,"total":10},{"year":2018,"recognized":0,"complementary":0,"rejected":15,"closed":5,"total":20},{"year":2019,"recognized":0,"complementary":0,"rejected":11,"closed":12,"total":23},{"year":2020,"recognized":0,"complementary":0,"rejected":5,"closed":0,"total":5},{"year":2022,"recognized":0,"complementary":99,"rejected":5,"closed":4172,"total":4276},{"year":2023,"recognized":0,"complementary":25,"rejected":5,"closed":20,"total":50},{"year":2024,"recognized":0,"complementary":17,"rejected":12,"closed":19,"total":48},{"year":2025,"recognized":0,"complementary":15,"rejected":18,"closed":5,"total":38}]},"per_1000":{"year":2025,"value":10.49,"numerator":199461,"denominator":19020271,"sources":["unhcr-pop-2026","wb-pop-2026"],"note":"Refugees per 1,000 people living in Romania."}},"headlines":{"over_time":{"text":"Ukrainian refugees in Romania rose from {n0} (2014) to {n1} (2025)","nums":[13,199461],"years":[2014,2025]},"where_people_are":{"text":"Romania hosts {p0} of all Ukrainian refugees (2025), up from {p1} in 2022","pcts":[3.8,1.8],"years":[2025,2022]}},"steps":{"brief":true,"key_numbers":true,"over_time":true,"where_people_are":true,"inside_outside":true,"compare":false,"context":true,"other_angles":true,"limitations":true,"sources":true},"brief_sources":[],"footnotes":{"fn_132a361b":"IDP figure in Ukraine includes 800,000 people who are in an IDP-like situation.","fn_15e33dc9":"The IDP figure has been aligned to the inter-agency methodology as defined in the 2020 Humanitarian Needs Overview. Figure of others of concern relates to persons who have specific protection needs and live in non-government-controlled areas or within 20 km of the contact line in government-controlled areas.","fn_2a8cdc51":"The number of refugee returns to Ukraine is estimated using IOM’s \"Returns Report — General Population Survey\" and \"Internal Displacement Report — General Population Survey\", Round 19. The estimated number of refugees who returned from abroad to their place of origin since the start of the war (1,066,000) was added to the estimated number of refugees who returned from abroad but not to their area of origin (355,000). This total was multiplied by the estimated proportion who returned in 2024 according to the GPS Return Report, excluding returnees for less than 3 months (which is the timeframe established in UNHCR’s Position Paper on Returns from Ukraine as indication of the intention of a stable return). This resulted in 14 per cent of total estimated returns from abroad (or 203,000 persons). The breakdown by former country of asylum is based on results from the latest UNHCR Intention Surveys with refugees returnees.","fn_3e8e7fae":"The IDP figure has been aligned to the inter-agency methodology as defined in the 2020 Humanitarian Needs Overview. Figure of others of concern relates to persons who have specific protection needs and live in non-government-controlled areas or within 20 km of the contact line in government-controlled areas.","fn_4f6fe86c":"Temporary protection granted to Ukrainians does not necessarily mean new displacement since it could include reapplications or reactivations from the refugees who were already granted refugee status following temporary visits to Ukraine as well as duplicated registrations across countries. Furthermore, Ukrainians that have been granted temporary protection may also have lodged individual asylum applications. See Ukraine Refugee Situation: Population movements, Factsheet #2, UNHCR (https://data.unhcr.org/en/documents/details/114591).","fn_5d5a5199":"UNHCR continues to report on the 2,534 refugees and 36,241 stateless people until their status and whereabouts can be ascertained. For asylum-seekers, end of year figures account also for those who confirmed their spontaneous departure to UNHCR from February 2022. The others of concern figure at end-2022 corresponds to the number of conflict-affected, non-displaced people assisted by UNHCR during the year.","fn_6e0523b1":"IDP figure in Ukraine includes 800,000 people who are in an IDP-like situation.","fn_7dcf65e3":"The IDP figure has been aligned to the inter-agency methodology as defined in the 2020 Humanitarian Needs Overview. Figure of others of concern relates to persons who have specific protection needs and live in non-government-controlled areas or within 20 km of the contact line in government-controlled areas.","fn_85797c16":"Temporary protection granted to Ukrainians does not necessarily mean new displacement since it could include reapplications or reactivations from the refugees who were already granted refugee status following temporary visits to Ukraine as well as duplicated registrations across countries. Furthermore, Ukrainians that have been granted temporary protection may also have lodged individual asylum applications. See Ukraine Refugee Situation: Population movements, Factsheet #2, UNHCR (https://data.unhcr.org/en/documents/details/114591).","fn_ae70406d":"The number of refugee returns to Ukraine is estimated using latest IOM’s \"Returns Report — General Population Survey\" and \"Internal Displacement Report — General Population Survey\", Round 19 (May 2025). The estimated number of refugees who returned from abroad to their place of origin since the start of the war (1,066,000) was added to the estimated number of refugees who returned from abroad but not to their area of origin (355,000). This total was multiplied by the estimated proportion who returned in 2022 according to the GPS Return Report, excluding returnees for less than 3 months (which is the timeframe established in UNHCR’s Position Paper on Returns from Ukraine as indication of the intention of a stable return). This resulted in 46 per cent of total estimated returns from abroad (or 660,000 persons). The breakdown by former country of asylum is based on results from the latest UNHCR Intention Surveys with refugees returnees. Figures have been adjusted retroactively to reflect latest survey results.","fn_b531e02e":"IDP figure in Ukraine includes 800,000 people who are in an IDP-like situation.","fn_bbd9f1f0":"Since February 2022, a number of Ukrainians have reached countries beyond Europe, where they are staying under various legal statuses. See UNHCR’s Ukraine Situation Operational Data Portal for up-to date statistics of refugees from Ukraine recorded in Europe and beyond.","fn_d6187d44":"UNHCR continues to report on the 2,534 refugees and 36,241 stateless people until their status and whereabouts can be ascertained. For asylum-seekers, end of year figures account also for those who confirmed their spontaneous departure to UNHCR from February 2022. The others of concern figure at end-2022 corresponds to the number of conflict-affected, non-displaced people assisted by UNHCR during the year.","fn_d7492616":"The number of refugee returns to Ukraine is estimated using latest IOM’s \"Returns Report — General Population Survey\" and \"Internal Displacement Report — General Population Survey\", Round 19 (May 2025). The estimated number of refugees who returned from abroad to their place of origin since the start of the war (1,066,000) was added to the estimated number of refugees who returned from abroad but not to their area of origin (355,000). This total was multiplied by the estimated proportion who returned in 2023 according to the GPS Return Report, excluding returnees for less than 3 months (which is the timeframe established in UNHCR’s Position Paper on Returns from Ukraine as indication of the intention of a stable return). This resulted in 28 per cent of total estimated returns from abroad (or 399,000 persons). The breakdown by former country of asylum is based on results from the latest UNHCR Intention Surveys with refugees returnees. Figures have been adjusted retroactively to reflect latest survey results.","fn_ddfa157e":"IDP figure in Ukraine includes 700,000 people who are in an IDP-like situation.","fn_ea267799":"IDP figure in Ukraine includes 800,000 people who are in an IDP-like situation.","fn_f0980c35":"The IDP figure has been aligned to the inter-agency methodology as defined in the 2022 Humanitarian Needs Overview, including an area-based improvement of the estimation of people displaced in government-controlled areas. The others of concern figure relates to persons who have specific protection needs and live in non-government-controlled areas."},"raw_files":{"conflict.csv":{"label":"IDMC GIDD, conflict and violence (HDX csv)","header":["iso3","country_name","year","new_displacement","new_displacement_rounded","total_displacement","total_displacement_rounded"]},"demographics/2025.zip":{"label":"UNHCR API download (demographics/2025.zip)","header":["Year","Country of origin","Country of origin (ISO)","Country of asylum","Country of asylum (ISO)","Population Type","Female 0 - 4","Female 5 - 11","Female 12 - 17","Female 18 - 59","Female 60","Female other","Female total","Male 0 - 4","Male 5 - 11","Male 12 - 17","Male 18 - 59","Male 60","Male other","Male total","Total"]},"persons_of_concern.csv":{"label":"UNHCR Refugee Data Finder download (persons_of_concern.csv)","header":["Year","Country of Asylum","Country of Origin","Country of Asylum ISO","Country of Origin ISO","Refugees","Asylum-seekers","IDPs","Other people in need of international protection","Stateless persons","Host community","Others of concern"]},"solutions/2022.zip":{"label":"UNHCR API download (solutions/2022.zip)","header":["Year","Country of origin","Country of origin (ISO)","Country of asylum","Country of asylum (ISO)","Returned refugees","Resettlement arrivals","Naturalisation","Returned IDPss"]},"solutions/2023.zip":{"label":"UNHCR API download (solutions/2023.zip)","header":["Year","Country of origin","Country of origin (ISO)","Country of asylum","Country of asylum (ISO)","Returned refugees","Resettlement arrivals","Naturalisation","Returned IDPss"]},"solutions/2024.zip":{"label":"UNHCR API download (solutions/2024.zip)","header":["Year","Country of origin","Country of origin (ISO)","Country of asylum","Country of asylum (ISO)","Returned refugees","Resettlement arrivals","Naturalisation","Returned IDPss"]},"solutions/2025.zip":{"label":"UNHCR API download (solutions/2025.zip)","header":["Year","Country of origin","Country of origin (ISO
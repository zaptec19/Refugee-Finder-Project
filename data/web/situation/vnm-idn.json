:15,"denominator":276758053,"sources":["unhcr-pop-2026","wb-pop-2026"],"note":"Refugees per 1,000 people living in Indonesia."}},"headlines":{"over_time":{"text":"Vietnamese refugees in Indonesia rose from {n0} (1978) to {n1} (1979), then fell to {n2} (2021)","nums":[2240,32200,15],"years":[1978,1979,2021]},"where_people_are":{"text":"Indonesia hosts {p0} of all Vietnamese refugees (2021), down from {p1} in 1978","pcts":[0.0,1.8],"years":[2021,1978]}},"steps":{"brief":true,"key_numbers":true,"over_time":true,"where_people_are":true,"inside_outside":true,"compare":false,"context":true,"other_angles":true,"limitations":true,"sources":true},"brief_sources":[],"footnotes":{"fn_5a135065":"The total statelessness figure reported relates to 641 stateless persons of Rohingya ethnicity who are also counted as refugees or asylum-seekers from Myanmar, mainly from Rakhine State. There are also indications that a potentially sizable population of non-displaced stateless persons exists for whom no data is available.","fn_aeee3eb5":"The total statelessness figure reported relates to 874 stateless persons of Rohingya ethnicity who are also counted as refugees or asylum-seekers from Myanmar, mainly from Rakhine State. UNHCR’s statistical reporting generally follows a methodology that reports only one legal status for each person of concern. However, due to the size of the stateless Rohingya population displaced from Myanmar, UNHCR considers it important to reflect the dual status of this population group as both displaced and stateless. This approach is being used for Indonesia for the first time in 2019. There are also indications that a potentially sizable population of non-displaced stateless persons exists for whom no data is available.","fn_f956aa4e":"The total statelessness figure reported relates to 582 stateless persons of Rohingya ethnicity who are also counted as refugees or asylum-seekers from Myanmar, mainly from Rakhine State. UNHCR’s statistical reporting generally follows a methodology that reports only one legal status for each person of concern. However, due to the size of the stateless Rohingya population displaced from Myanmar, UNHCR considers it important to reflect the dual status of this population group as both displaced and stateless. This approach is being used for Indonesia for the first time in 2019. There are also indications that a potentially sizable population of non-displaced stateless persons exists for whom no data is available."},"raw_files":{"demographics/2021.zip":{"label":"UNHCR API download (demographics/2021.zip)","header":["Year","Country of origin","Country of origin (ISO)","Country of asylum","Country of asylum (ISO)","Population Type","Female 0 - 4","Female 5 - 11","Female 12 - 17","Female 18 - 59","Female 60","Female other","Female total","Male 0 - 4","Male 5 - 11","Male 12 - 17","Male 18 - 59","Male 60","Male other","Male total","Total"]},"persons_of_concern.csv":{"label":"UNHCR Refugee Data Finder download (persons_of_concern.csv)","header":["Year","Country of Asylum","Country of Origin","Country of Asylum ISO","Country of Origin ISO","Refugees","Asylum-seekers","IDPs","Other people in need of international protection","Stateless persons","Host community","Others of concern"]},"solutions/1980.zip":{"label":"UNHCR API download (solutions/1980.zip)","header":["Year","Country of origin","Country of origin (ISO)","Country of asylum","Country of asylum (ISO)","Returned refugees","Resettlement arrivals","Naturalisation","Returned IDPss"]},"solutions/1990.zip":{"label":"UNHCR API download (solutions/1990.zip)","header":["Year","Country of origin","Country of origin (ISO)","Country of asylum","Country of asylum (ISO)","Returned refugees","Resettlement arrivals","Naturalisation","Returned IDPss"]},"solutions/1991.zip":{"label":"UNHCR API download (solutions/1991.zip)","header":["Year","Country of origin","Country of origin (ISO)","Country of asylum","Country of asylum (ISO)","Returned refugees","Resettleme
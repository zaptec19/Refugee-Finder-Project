d":0,"complementary":0,"rejected":0,"closed":5,"total":5}]},"per_1000":{"year":2025,"value":0.0,"numerator":60,"denominator":143513328,"sources":["unhcr-pop-2026","wb-pop-2026"],"note":"Refugees per 1,000 people living in the Russian Federation."}},"headlines":{"over_time":{"text":"Moldovan refugees in the Russian Federation fell from {n0} (1996) to {n1} (2011)","nums":[5132,0],"years":[1996,2011]},"where_people_are":{"text":"The Russian Federation hosts {p0} of all Moldovan refugees (2025), down from {p1} in 1996","pcts":[1.0,88.1],"years":[2025,1996]}},"steps":{"brief":true,"key_numbers":true,"over_time":true,"where_people_are":true,"inside_outside":true,"compare":false,"context":true,"other_angles":true,"limitations":true,"sources":true},"brief_sources":[],"footnotes":{"fn_00fca19c":"According to the results of the 2020 All-Russia Census finalized at end-2022, some 91,173 persons declared themselves stateless. The number of persons who have acquired Russian citizenship in each subsequent year has been subtracted from this total, including 2,035 persons who obtained Russian citizenship in 2024.","fn_0504a752":"Figure refers to the census figure from 2010 adjusted to reflect the number of stateless persons who acquired nationality in 2011-2017.","fn_2bc2040a":"According to the results of the 2020 All-Russia Census finalized at end 2022, some 91,173 persons declared themselves stateless of whom 2,988 persons obtained Russian citizenship in 2023.","fn_3962fd68":"The statelessness figure refers to the census figure from 2010 adjusted to reflect the number of stateless persons who acquired nationality in 2011-2017.","fn_4421479b":"The statelessness figure refers to the census figure from 2010 adjusted to reflect the number of stateless persons who acquired nationality in 2011-2016.","fn_532d92ac":"The statelessness figure refers to the census figure from 2010 adjusted to reflect the number of stateless persons who acquired nationality in 2011-2018.","fn_69c3834e":"The figure refers to the census figure from 2010 adjusted to reflect the number of stateless persons who acquired nationality in 2011-2015. The figure includes 12,881 stateless persons holding a temporary or a permanent residence permit.","fn_74833d01":"The figure for the Russian Federation includes 6,894 Ukrainians who were granted refugee or temporary asylum status by end-2024. Moreover, as of mid-2023 an estimated 1.2 million Ukrainians were recorded in the Russian Federation under different legal forms of stay (other than refugee or temporary asylum status) and reported by UNHCR as persons in a refugee-like situation. However, this figure has not been updated since June 2023, and therefore can no longer be included in UNHCR’s official statistics for end of 2024.","fn_7492962e":"The figure for the Russian Federation includes 65,400 Ukrainians who were granted refugee or temporary asylum status, as well as those recorded in the country in 2022 under other forms of stay.","fn_7ee17c54":"Figure refers to the census figure from 2010 adjusted to reflect the number of stateless persons who acquired nationality in 2011-2016.","fn_d0aea653":"Figure of Stateless persons refers to the census figure from 2010 adjusted to reflect the number of stateless persons who acquired nationality in 2011- 2015. The figure includes 12,881 stateless persons holding a temporary or a permanent residence permit.","fn_f2c3866d":"By the end of 2021, UNHCR reported 54,025 stateless persons in the Russian Federation. This estimation was based on the number of self-proclaimed stateless persons identified during the 2010 census (178,000), from whom the number of persons who obtained Russian citizenship throughout the reporting periods was subtracted on a yearly basis since 2011. According to the results of the 2020 All-Russia Census finalized at end 2022, some 95,193 persons declared themselves stateless and this figure was taken as a baseline for statistics on statelessness for 2022, causing an increase of 41,139 in estimated statelessness population figures for Russia compared to end-2021 (but still a decrease compared to latest Census).","fn_ff749cec":"According to the results of the 2020 All-Russia Census finalized at end-2022, some 95,193 persons declared themselves stateless. The number of persons who have acquired Russian citizenship in each subsequent year has been subtracted from this total."},"raw_files":{"persons_of_concern.csv":{"label":"UNHCR Refugee Data Finder download (persons_of_concern.csv)","header":["Year","Country of Asylum","Country of Origin","Country of Asylum ISO","Country of Origin ISO","Refugees","Asylum-seekers","IDPs","Other people in need of international protection","Stateless persons","Host community","Others of concern"]}},"raw_rows":{"persons_of_concern.csv#L101637":{"file_key":"persons_of_concern.csv","line":101637,"row":["2019","Russian Federation","Rep. of Moldova","RUS","MDA","30","8","0","0","0","0","0"]},"persons_of_concern.csv#L107104":{"file_key":"persons_of_concern.csv","line":107104,"row":["2020","Russian Federation","Rep. of Moldova","RUS","MDA","29","5","0","0","0","0","0"]},"persons_of_concern.csv#L112668":{"file_key":"persons_of_concern.csv","line":112668,"row":["2021","Russian Federation","Rep. of Moldova","RUS","MDA","22","0","0","0","0","0","0"]},"persons_of_concern.csv#L11570":{"file_key":"persons_of_concern.csv","line":11570,"row":["1996","Russian Federation","Rep. of Moldova","RUS","MDA","5132","0","0","0","0","0","0"]},"persons_of_concern.csv#L118559":{"file_key":"persons_of_concern.csv","line":118559,"row":["2022","Russian Federation","Rep. of Moldova","RUS","MDA","27","7","0","0","0","0","0"]},"persons_of_concern.csv#L124612":{"file_key":"persons_of_concern.csv","line":124612,"row":["2023","Russian Federation","Rep. of Moldova","RUS","MDA","57","8","0","0","0","0","0"]},"persons_of_concern.csv#L130749":{"file_key":"persons_of_concern.csv","line":130749,"row":["2024","Russian Federation","Rep. of Moldova",